{
  "name": "@w00ye01/agentready",
  "version": "0.1.0",
  "description": "Check whether a repository is ready for AI coding agents, and generate an AGENTS.md spec for it.",
  "type": "module",
  "bin": {
    "agentready": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "cli",
    "ai-agent",
    "llm",
    "agents-md",
    "developer-experience",
    "repository-health"
  ],
  "author": "w00ye01",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w00ye01/toss.git",
    "directory": "agentready"
  },
  "homepage": "https://github.com/w00ye01/toss/tree/main/agentready#readme",
  "publishConfig": {
    "access": "public"
  }
}
